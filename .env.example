# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project -> Settings -> Environment Variables.

# --- Database (Supabase) -------------------------------------------------
# Project URL: Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret (service_role) key - SERVER ONLY. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- Admin dashboard ------------------------------------------------------
# 16+ random characters used to sign admin sessions
ADMIN_SECRET=
# Optional: password accepted before the first sign-in stores one
ADMIN_PASSWORD=

# --- Email (https://resend.com) --------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@afristemglobal.com
MAIL_FROM=AFRISTEM Website <no-reply@afristemglobal.org>

# --- Optional ---------------------------------------------------------------
# Forward newsletter sign-ups to another service as JSON {email, source}
NEWSLETTER_WEBHOOK_URL=
# Canonical site address for metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://afristemglobal.org
