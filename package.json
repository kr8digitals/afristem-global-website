{
  "name": "afristem-global-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=1536 next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint src",
    "audit:prod": "npm audit --omit=dev",
    "security": "npm audit --omit=dev && npm run lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "AFRISTEM Global — modern Next.js website. Inspiring the next generation of African innovators.",
  "engines": {
    "node": ">=20.9"
  }
}
